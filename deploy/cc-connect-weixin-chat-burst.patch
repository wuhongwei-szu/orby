@@ -0,0 +1,144 @@
+package core
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestWeixinChatControlsStopPrefixCancelsBufferedInput(t *testing.T) {
+	t.Parallel()
+	e, platform, agentSession := newWeixinChatTest(t)
+	p := platform.(*weixinChatFixturePlatform)
+	e.ReceiveMessage(p, weixinChatInput("active", strings.Repeat("p", 97)))
+	waitForChatReplayPrompt(t, agentSession)
+
+	e.ReceiveMessage(p, weixinChatInput("first", "first pending bubble"))
+	e.ReceiveMessage(p, weixinChatInput("second", "second pending bubble"))
+	e.ReceiveMessage(p, weixinChatInput("stop", "/sto"))
+	// A flush into the busy queue before stopping exposes queue or reset replies.
+	if got := p.getSent(); len(got) != 1 || got[0] != e.i18n.T(MsgExecutionStopped) {
+		t.Fatalf("replies = %q, want only the stop confirmation", got)
+	}
+
+	deadline := time.NewTimer(weixinChatWindow + 100*time.Millisecond)
+	defer deadline.Stop()
+	tick := time.NewTicker(10 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		if got := chatReplayPrompts(agentSession); len(got) != 1 {
+			t.Fatalf("stopped batch reached the agent: %q", got)
+		}
+		select {
+		case <-tick.C:
+		case <-deadline.C:
+			return
+		}
+	}
+}
+
+func TestWeixinChatControlsInvalidSwitchPreservesBufferedInput(t *testing.T) {
+	t.Parallel()
+	e, platform, agentSession := newWeixinChatTest(t)
+	p := platform.(*weixinChatFixturePlatform)
+	first := weixinChatInput("first", "first preserved bubble")
+	second := weixinChatInput("second", "second preserved bubble")
+	const missing = "missing-fixture-session"
+
+	e.ReceiveMessage(p, first)
+	e.ReceiveMessage(p, second)
+	e.ReceiveMessage(p, weixinChatInput("switch", "/switch "+missing))
+	if got := p.getSent(); len(got) != 1 || got[0] != fmt.Sprintf(e.i18n.T(MsgSwitchNoMatch), missing) {
+		t.Fatalf("replies = %q, want the missing-session error", got)
+	}
+	prompt := waitForChatReplayPrompt(t, agentSession)
+	firstAt := strings.Index(prompt, first.Content)
+	secondAt := strings.Index(prompt, second.Content)
+	if firstAt < 0 || secondAt <= firstAt {
+		t.Fatalf("agent prompt lost or reordered the buffered input: %q", prompt)
+	}
+}
+
+type weixinChatControlsTypingPlatform struct {
+	*weixinChatFixturePlatform
+	typingCalls atomic.Int32
+	secondStart chan struct{}
+	resume      chan struct{}
+}
+
+func (p *weixinChatControlsTypingPlatform) StartTyping(ctx context.Context, _ any) func() {
+	if p.typingCalls.Add(1) == 2 {
+		close(p.secondStart)
+		select {
+		case <-p.resume:
+		case <-ctx.Done():
+		}
+	}
+	return func() {}
+}
+
+func TestWeixinChatControlsBusySwitchPreventsOldSend(t *testing.T) {
+	t.Parallel()
+	const targetID = "fixture-switch-target"
+	const targetSummary = "Fixture destination session"
+	old := newQueuingSession("fixture-switch-old")
+	target := newQueuingSession(targetID)
+	p := &weixinChatControlsTypingPlatform{
+		weixinChatFixturePlatform: testWeixinAccount("test-account", "test-peer"),
+		secondStart:               make(chan struct{}),
+		resume:                    make(chan struct{}),
+	}
+	resume := sync.OnceFunc(func() { close(p.resume) })
+	defer resume()
+	agent := &controllableAgent{
+		listFn: func() ([]AgentSessionInfo, error) {
+			return []AgentSessionInfo{{ID: targetID, Summary: targetSummary, MessageCount: 1}}, nil
+		},
+		startSessionFn: func(_ context.Context, id string) (AgentSession, error) {
+			if id == targetID {
+				return target, nil
+			}
+			return old, nil
+		},
+	}
+	e := NewEngine("test", agent, []Platform{p}, "", LangEnglish)
+	e.baseWorkDir = t.TempDir()
+	t.Cleanup(func() { _ = e.Stop() })
+
+	first := weixinChatInput("active", strings.Repeat("p", 97))
+	e.ReceiveMessage(p, first)
+	waitForChatReplayPrompt(t, old)
+	oldSession := e.sessions.GetOrCreateActive(first.SessionKey)
+	for i := 1; i <= weixinChatMaxMessages; i++ {
+		e.ReceiveMessage(p, weixinChatInput(fmt.Sprint(i), fmt.Sprintf("queued bubble %d", i)))
+	}
+	old.events <- Event{Type: EventResult, Content: "first turn finished", Done: true}
+	select {
+	case <-p.secondStart:
+	case <-time.After(3 * time.Second):
+		t.Fatal("queued batch did not reach its StartTyping barrier")
+	}
+
+	e.ReceiveMessage(p, weixinChatInput("switch", "/switch "+targetID))
+	if !strings.Contains(strings.Join(p.getSent(), "\n"), targetSummary) {
+		t.Fatalf("switch did not confirm the target: %q", p.getSent())
+	}
+	resume()
+	if !e.waitForSessionLock(oldSession, 2*time.Second) {
+		t.Fatal("old turn did not exit after switching sessions")
+	}
+	oldSession.Unlock()
+
+	probe := weixinChatInput("new", strings.Repeat("q", 97))
+	e.ReceiveMessage(p, probe)
+	if got := waitForChatReplayPrompt(t, target); !strings.Contains(got, probe.Content) || strings.Contains(got, "queued bubble") {
+		t.Errorf("unexpected prompt in the switched session: %q", got)
+	}
+	if got := chatReplayPrompts(old); len(got) != 1 {
+		t.Errorf("queued batch reached the old agent after switch: %q", got)
+	}
+}
