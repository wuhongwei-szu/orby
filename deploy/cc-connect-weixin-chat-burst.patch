+package core
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type weixinChatFixturePlatform struct {
+	*materialAccountPlatform
+	peer string
+}
+
+func (p *weixinChatFixturePlatform) OrderedDirectInboxPeer() string { return p.peer }
+
+func testWeixinAccount(account, peer string) *weixinChatFixturePlatform {
+	return &weixinChatFixturePlatform{&materialAccountPlatform{&stubPlatformEngine{n: "weixin"}, account}, peer}
+}
+
+func newWeixinChatTest(t *testing.T) (*Engine, Platform, *queuingAgentSession) {
+	t.Helper()
+	p := testWeixinAccount("test-account", "test-peer")
+	s := newQueuingSession("weixin-chat-replay")
+	store := t.TempDir()
+	e := NewEngine("test", &controllableAgent{nextSession: s}, []Platform{p}, filepath.Join(store, "sessions.json"), LangEnglish)
+	e.baseWorkDir = store
+	t.Cleanup(func() { _ = e.Stop() })
+	return e, p, s
+}
+
+func weixinChatInput(id, content string) *Message {
+	return &Message{
+		SessionKey:        "weixin:dm:test-peer",
+		Platform:          "weixin",
+		UserID:            "test-peer",
+		MessageID:         id,
+		Content:           content,
+		SourceUserContent: content,
+		WeixinPlainText:   true,
+	}
+}
+
+func chatReplayPrompts(s *queuingAgentSession) []string {
+	s.sendMu.Lock()
+	defer s.sendMu.Unlock()
+	return append([]string(nil), s.sendCalls...)
+}
+
+func waitForChatReplayPrompt(t *testing.T, s *queuingAgentSession) string {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if ps := chatReplayPrompts(s); len(ps) > 0 {
+			return ps[0]
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("agent did not receive the chat input")
+	return ""
+}
+
+func TestWeixinShortChatWaitsForSecondBubbleAndKeepsOrder(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	first := weixinChatInput("first", "帮我转告对方")
+	second := weixinChatInput("second", "今晚六点见")
+	e.handleMessage(p, first)
+	// Replay the observed gap between the incomplete request and its detail.
+	time.Sleep(2020 * time.Millisecond)
+	if ps := chatReplayPrompts(s); len(ps) != 0 {
+		t.Fatal("agent started on the first fragment before the second arrived")
+	}
+	e.handleMessage(p, second)
+	prompt := waitForChatReplayPrompt(t, s)
+	a, b := strings.Index(prompt, first.Content), strings.Index(prompt, second.Content)
+	if a < 0 || b <= a {
+		t.Fatalf("expected both original bubbles in order, got %q", prompt)
+	}
+	if count := len(chatReplayPrompts(s)); count != 1 {
+		t.Fatalf("received %d model turns, want 1", count)
+	}
+	history := e.sessions.GetOrCreateActive(first.SessionKey).GetHistory(10)
+	if len(history) != 2 || history[0].Content != first.Content || history[1].Content != second.Content {
+		t.Fatalf("original bubbles were not kept individually: %+v", history)
+	}
+}
+
+func TestWeixinBusyQueueCombinesOnlyAdjacentShortChat(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	e.handleMessage(p, weixinChatInput("running", strings.Repeat("p", 97)))
+	waitForChatReplayPrompt(t, s)
+	e.handleMessage(p, weixinChatInput("first", "把两条合起来"))
+	e.handleMessage(p, weixinChatInput("second", "这句是补充"))
+	s.events <- Event{Type: EventResult, Content: "done", Done: true}
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		ps := chatReplayPrompts(s)
+		if len(ps) == 2 {
+			if !strings.Contains(ps[1], "把两条合起来") || !strings.Contains(ps[1], "这句是补充") {
+				t.Fatalf("busy queue split the follow-up: %q", ps[1])
+			}
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("queued follow-up was not processed after the first turn")
+}
+
+func TestWeixinChatControlCancelsInputStillInWindow(t *testing.T) {
+	for _, command := range []string{"stop", "new"} {
+		t.Run(command, func(t *testing.T) {
+			t.Parallel()
+			e, p, s := newWeixinChatTest(t)
+			e.handleMessage(p, weixinChatInput("pending", "等会再回答"))
+			e.handleMessage(p, weixinChatInput("control", "/"+command))
+			time.Sleep(weixinChatWindow + 100*time.Millisecond)
+			if len(chatReplayPrompts(s)) != 0 {
+				t.Fatal("the cancelled input reached the agent")
+			}
+		})
+	}
+}
+
+func TestWeixinChatStopPreventsLateAgentStartup(t *testing.T) {
+	e, p, _ := newWeixinChatTest(t)
+	msg := weixinChatInput("old", "这一条需要停下")
+	lane := e.directWeixinChatLane(p, msg)
+	if lane == nil {
+		t.Fatal("fixture did not receive a direct inbox")
+	}
+	msg.weixinChatTicket = weixinChatTicket{lane: lane, generation: lane.generation.Load()}
+	e.agent.(*controllableAgent).startSessionFn = func(context.Context, string) (AgentSession, error) {
+		t.Error("a stopped turn started an agent")
+		return nil, errors.New("fixture agent must not start")
+	}
+
+	session := e.sessions.GetOrCreateActive(msg.SessionKey)
+	if !session.TryLock() {
+		t.Fatal("fixture could not lock the active session")
+	}
+	e.ensureInteractiveStateForQueueing(msg.SessionKey, p, msg.ReplyCtx)
+	e.handleMessage(p, weixinChatInput("control", "/stop"))
+	// The previous dispatch has been admitted but its worker has not started.
+	e.processInteractiveMessageWith(p, msg, session, e.agent, e.sessions, msg.SessionKey, "", "")
+	if history := session.GetHistory(0); len(history) != 0 {
+		t.Fatal("a stopped turn wrote a late history entry")
+	}
+}
+
+func TestWeixinChatDoesNotShareAmbiguousAccountsOrPeers(t *testing.T) {
+	for _, other := range []*weixinChatFixturePlatform{
+		testWeixinAccount("second-account", "test-peer"),
+		testWeixinAccount("test-account", "second-peer"),
+	} {
+		p := testWeixinAccount("test-account", "test-peer")
+		e := NewEngine("test", &controllableAgent{}, []Platform{p, other}, "", LangEnglish)
+		if e.directWeixinChatLane(p, weixinChatInput("m1", "这条不能混在一起")) != nil {
+			t.Error("batching was enabled for ambiguous account or peer ownership")
+		}
+		_ = e.Stop()
+	}
+}
+
+func TestWeixinSixBubblesConsumeOneBusyQueueSlotAndSaveOriginals(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	e.SetMaxQueuedMessages(1)
+	e.handleMessage(p, weixinChatInput("running", strings.Repeat("p", 97)))
+	waitForChatReplayPrompt(t, s)
+	texts := []string{"一条", "二条", "三条", "四条", "五条", "六条"}
+	for _, text := range texts {
+		e.handleMessage(p, weixinChatInput(text, text))
+	}
+	s.events <- Event{Type: EventResult, Content: "done", Done: true}
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		ps := chatReplayPrompts(s)
+		if len(ps) == 2 {
+			saved, err := os.ReadFile(filepath.Join(e.baseWorkDir, "sessions.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var snapshot sessionSnapshot
+			if err := json.Unmarshal(saved, &snapshot); err != nil {
+				t.Fatal(err)
+			}
+			key := weixinChatInput("", "").SessionKey
+			active := snapshot.Sessions[snapshot.ActiveSession[key]]
+			if active == nil || len(active.History) < len(texts) {
+				t.Fatal("saved active session is missing its original bubbles")
+			}
+			history := active.History[len(active.History)-len(texts):]
+			offset := -1
+			for i, text := range texts {
+				at := strings.Index(ps[1], text)
+				if at <= offset || history[i].Role != "user" || history[i].Content != text {
+					t.Fatalf("missing or unordered input %q in batch or saved history", text)
+				}
+				offset = at
+			}
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("full input batch was not sent as one follow-up")
+}
+
+func TestWeixinChatSurvivesIdleAgentEvictionBeforeDispatch(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	msg := weixinChatInput("incoming", "接得上吗")
+	old := newControllableSession("old-idle")
+	state := &interactiveState{agentSession: old, platform: p, agentSessionIdleToken: 42}
+	e.interactiveStates[msg.SessionKey] = state
+	e.handleMessage(p, msg)
+	e.cleanupInteractiveStateForIdleToken(msg.SessionKey, state, 42, time.Minute)
+	if got := waitForChatReplayPrompt(t, s); !strings.Contains(got, msg.Content) {
+		t.Fatalf("input did not survive idle eviction: %q", got)
+	}
+}
+
+func TestWeixinMediaBoundaryFlushesPendingTextWithoutCombining(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	e.handleMessage(p, weixinChatInput("first", "还有一个附件"))
+	media := weixinChatInput("file", "看这个文档")
+	media.WeixinPlainText = false
+	media.Files = []FileAttachment{{FileName: "fixture.docx", MimeType: "application/octet-stream", Data: []byte("fixture bytes")}}
+	e.handleMessage(p, media)
+	first := waitForChatReplayPrompt(t, s)
+	if !strings.Contains(first, "还有一个附件") || strings.Contains(first, "看这个文档") {
+		t.Fatalf("media was not kept separate: %q", first)
+	}
+}
+
+func TestWeixinBurstKeepsSecondBubbleWhenPreviousTurnCompletesMidWindow(t *testing.T) {
+	e, p, s := newWeixinChatTest(t)
+	e.handleMessage(p, weixinChatInput("running", strings.Repeat("p", 97)))
+	waitForChatReplayPrompt(t, s)
+	e.handleMessage(p, weixinChatInput("first", "接下来通知对方一下"))
+	s.events <- Event{Type: EventResult, Content: "done", Done: true}
+	time.Sleep(300 * time.Millisecond)
+	if ps := chatReplayPrompts(s); len(ps) != 1 {
+		t.Fatalf("previous turn ended and started on an incomplete bubble: %q", ps)
+	}
+	e.handleMessage(p, weixinChatInput("second", "请对方稍等"))
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		ps := chatReplayPrompts(s)
+		if len(ps) == 2 {
+			if !strings.Contains(ps[1], "接下来通知对方一下") || !strings.Contains(ps[1], "请对方稍等") {
+				t.Fatalf("the follow-up was split: %q", ps[1])
+			}
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatal("the combined follow-up did not reach the agent")
+}
