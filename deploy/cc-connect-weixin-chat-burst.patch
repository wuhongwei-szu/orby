+package weixin
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/chenhg5/cc-connect/core"
+)
+
+func TestOrderedDirectInboxPreservesPollMessageOrder(t *testing.T) {
+	p := &Platform{accountLabel: "fixture-account", allowFrom: "test-peer"}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	update := func(id int64, text string) weixinMessage {
+		return weixinMessage{FromUserID: "test-peer", MessageType: messageTypeUser, MessageID: id,
+			ItemList: []messageItem{{Type: messageItemText, TextItem: &textItem{Text: text}}}}
+	}
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	seen := make(chan *core.Message, 3)
+	go p.dispatchUpdates(ctx, []weixinMessage{update(1, "一"), update(2, "二"), update(3, "/stop")},
+		func(_ core.Platform, msg *core.Message) {
+			if msg.MessageID == "1" {
+				close(entered)
+				select {
+				case <-ctx.Done():
+					return
+				case <-release:
+				}
+			}
+			seen <- msg
+		})
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("first update did not enter the handler")
+	}
+	select {
+	case msg := <-seen:
+		t.Fatalf("update %s overtook the first packet", msg.MessageID)
+	case <-time.After(40 * time.Millisecond):
+	}
+	close(release)
+	for _, want := range []string{"一", "二", "/stop"} {
+		select {
+		case msg := <-seen:
+			if msg.Content != want || !msg.WeixinPlainText {
+				t.Fatalf("got %+v, want original text %q", msg, want)
+			}
+		case <-time.After(time.Second):
+			t.Fatalf("missing input %q", want)
+		}
+	}
+}
+
+func TestPlainItemClassificationUsesTheOriginalPacket(t *testing.T) {
+	text := messageItem{Type: messageItemText, TextItem: &textItem{Text: "caption or transcription"}}
+	quote := text
+	quote.RefMsg = &refMessage{}
+	for _, items := range [][]messageItem{
+		{text, {Type: messageItemImage}},
+		{text, {Type: messageItemVoice}},
+		{quote},
+	} {
+		if plainTextItems(items) {
+			t.Fatal("non-text content passed the batching gate")
+		}
+	}
+	if !plainTextItems([]messageItem{text}) {
+		t.Fatal("plain text was rejected")
+	}
+}
