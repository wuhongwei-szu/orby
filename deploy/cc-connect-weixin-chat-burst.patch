@@ -0,0 +1,212 @@
+package core
+
+import (
+	"errors"
+	"log/slog"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	weixinChatWindow      = 2400 * time.Millisecond
+	weixinChatMaxMessages = 6
+	weixinChatMaxRunes    = 96
+)
+
+type weixinDirectInbox interface {
+	OrderedDirectInboxPeer() string
+}
+
+type pendingWeixinChat struct {
+	timer    *time.Timer
+	deadline time.Time
+	messages []*Message
+	deliver  func(*Message)
+}
+
+type weixinChatLane struct {
+	mu         sync.Mutex
+	generation atomic.Uint64
+	pending    *pendingWeixinChat
+}
+
+var errWeixinChatCancelled = errors.New("Weixin chat turn superseded by a session command")
+
+type weixinChatTicket struct {
+	lane       *weixinChatLane
+	generation uint64
+}
+
+func (ticket weixinChatTicket) current() bool {
+	return ticket.lane == nil || ticket.lane.generation.Load() == ticket.generation
+}
+
+// The authorized command handler holds lane.mu when it invalidates inputs.
+func (ticket weixinChatTicket) cancel() bool {
+	lane := ticket.lane
+	if lane == nil {
+		return false
+	}
+	waiting := lane.pending != nil
+	lane.discard()
+	lane.generation.Add(1)
+	return waiting
+}
+
+// The legacy shared session keys are safe to batch only when each configured
+// Weixin account has a unique explicit peer, and this sender owns the DM.
+func (e *Engine) directWeixinChatLane(p Platform, msg *Message) *weixinChatLane {
+	inbox, ok := p.(weixinDirectInbox)
+	if !ok || e.multiWorkspace || p.Name() != "weixin" || msg.Platform != "weixin" ||
+		msg.UserID == "" || msg.SessionKey != "weixin:dm:"+msg.UserID ||
+		!strings.EqualFold(inbox.OrderedDirectInboxPeer(), msg.UserID) {
+		return nil
+	}
+	account, peer := PlatformAccountID(p), inbox.OrderedDirectInboxPeer()
+	var accounts, peers int
+	for _, platform := range e.platforms {
+		if platform.Name() != "weixin" {
+			continue
+		}
+		other, ok := platform.(weixinDirectInbox)
+		if !ok || other.OrderedDirectInboxPeer() == "" {
+			return nil
+		}
+		if PlatformAccountID(platform) == account {
+			accounts++
+		}
+		if strings.EqualFold(other.OrderedDirectInboxPeer(), peer) {
+			peers++
+		}
+	}
+	if account == "" || accounts != 1 || peers != 1 {
+		return nil
+	}
+	key := materialIdentity(p, msg.SessionKey, msg.UserID)
+	lane, _ := e.weixinChatLanes.LoadOrStore(key, &weixinChatLane{})
+	return lane.(*weixinChatLane)
+}
+
+func isWeixinChatBubble(msg *Message) bool {
+	text := strings.TrimSpace(msg.Content)
+	return msg.WeixinPlainText && !msg.materialInput && !msg.IsPermissionResponse &&
+		msg.ExtraContent == "" && msg.ModeOverride == "" && msg.OnAccepted == nil &&
+		msg.Audio == nil && !msg.FromVoice && msg.Location == nil &&
+		len(msg.Images) == 0 && len(msg.Files) == 0 &&
+		text != "" && text == strings.TrimSpace(msg.SourceUserContent) &&
+		!strings.HasPrefix(text, "/") && !strings.HasPrefix(text, "!") &&
+		utf8.RuneCountInString(text) <= weixinChatMaxRunes
+}
+
+// Called with the lane locked, after normal validation of each individual input.
+func (lane *weixinChatLane) add(e *Engine, p Platform, msg *Message, deliver func(*Message)) {
+	if lane.pending != nil && !time.Now().Before(lane.pending.deadline) {
+		lane.flush(e, p)
+	}
+	if lane.pending == nil {
+		batch := &pendingWeixinChat{deadline: time.Now().Add(weixinChatWindow)}
+		lane.pending = batch
+		batch.timer = time.AfterFunc(weixinChatWindow, func() {
+			lane.mu.Lock()
+			defer lane.mu.Unlock()
+			if lane.pending == batch {
+				lane.flush(e, p)
+			}
+		})
+	}
+	lane.pending.messages = append(lane.pending.messages, msg)
+	lane.pending.deliver = deliver
+	if len(lane.pending.messages) >= weixinChatMaxMessages {
+		lane.flush(e, p)
+	}
+}
+
+func (lane *weixinChatLane) discard() {
+	if lane != nil && lane.pending != nil {
+		lane.pending.timer.Stop()
+		lane.pending = nil
+	}
+}
+
+func (lane *weixinChatLane) retract(messageID string) {
+	if lane == nil || lane.pending == nil || messageID == "" {
+		return
+	}
+	messages := lane.pending.messages
+	for i, message := range messages {
+		if message.MessageID == messageID {
+			lane.pending.messages = append(messages[:i], messages[i+1:]...)
+			if len(lane.pending.messages) == 0 {
+				lane.discard()
+			}
+			return
+		}
+	}
+}
+
+func (lane *weixinChatLane) flush(e *Engine, p Platform) {
+	if lane == nil || lane.pending == nil {
+		return
+	}
+	pending := lane.pending
+	lane.discard()
+	if e.ctx.Err() != nil {
+		return
+	}
+	messages := pending.messages
+	if len(messages) == 1 {
+		pending.deliver(messages[0])
+		return
+	}
+	parts := make([]queuedMessage, 0, len(messages))
+	for _, msg := range messages {
+		parts = append(parts, e.queuedMaterial(p, msg, nil, false))
+	}
+	joined := mergeWeixinChatParts(parts)
+	latest := *messages[len(messages)-1]
+	latest.Content = joined.content
+	latest.UserMessageTimeMs = joined.userMessageTimeMs
+	latest.weixinChatParts = parts
+	slog.Info("weixin chat input batched", "messages", len(parts), "window_ms", weixinChatWindow.Milliseconds())
+	pending.deliver(&latest)
+}
+
+func mergeWeixinChatParts(parts []queuedMessage) queuedMessage {
+	joined := parts[len(parts)-1]
+	if len(parts) == 1 {
+		return joined
+	}
+	joined.materialParts = parts
+	var prompt strings.Builder
+	prompt.WriteString("【同一用户连续发来的消息，按到达顺序列出。先看完整组，再一起回应。】")
+	for _, part := range parts {
+		prompt.WriteString("\n\n【独立消息】\n")
+		prompt.WriteString(part.content)
+		if part.userMessageTimeMs > joined.userMessageTimeMs {
+			joined.userMessageTimeMs = part.userMessageTimeMs
+		}
+	}
+	joined.content = prompt.String()
+	return joined
+}
+
+func (input queuedMessage) addChatHistory(session *Session) bool {
+	if input.material || len(input.materialParts) == 0 {
+		session.AddHistory("user", input.content)
+		return false
+	}
+	for _, original := range input.materialParts {
+		session.AddHistory("user", original.content)
+	}
+	return true
+}
+
+func (input queuedMessage) languageContent() string {
+	if !input.material && len(input.materialParts) > 0 {
+		return input.sourceUserContent
+	}
+	return input.content
+}
